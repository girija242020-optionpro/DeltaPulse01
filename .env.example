# Dhan authentication: set privately in Render, never commit actual secrets
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# HTTP / CORS
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
CORS_ORIGIN=*
API_PREFIX=/api
LOG_LEVEL=info

# Instrument subscription format: SEGMENT:SECURITY_ID, comma-separated
# Verify every security ID and segment against the current Dhan instrument master.
LIVE_INSTRUMENTS=IDX_I:13
DEPTH_INSTRUMENTS=NSE_FNO:13
DEFAULT_INDEX=NIFTY
NIFTY_SECURITY_ID=13
NIFTY_SEGMENT=IDX_I
NIFTY_OPTION_SEGMENT=NSE_FNO
SENSEX_SECURITY_ID=51
SENSEX_SEGMENT=IDX_I
SENSEX_OPTION_SEGMENT=BSE_FNO

# Feed and token lifecycle
AUTO_GENERATE_ACCESS_TOKEN=true
TOKEN_REFRESH_BEFORE_EXPIRY_MINUTES=10
AUTH_RETRY_DELAY_MS=5000
AUTH_MAX_RETRIES=3
ENABLE_LIVE_FEED=true
ENABLE_20_DEPTH=true
AUTO_RECONNECT=true
RECONNECT_DELAY_MS=3000
MAX_RECONNECT_DELAY_MS=30000
STALE_AFTER_MS=5000
MAX_CLIENTS=100
MAX_SUBSCRIPTIONS=5000
DEPTH_CONTRACTS=20

# Candle engine and history retention
CANDLE_INTERVALS=1,3,5,15
MAX_TICKS_PER_INSTRUMENT=3000
MAX_CANDLES_PER_INSTRUMENT=50000
TICK_BUFFER_SIZE=20000
DATA_DIR=/var/data
HISTORY_FLUSH_MS=5000

# Optional Web Push (VAPID). Set both keys and a contact subject to enable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
